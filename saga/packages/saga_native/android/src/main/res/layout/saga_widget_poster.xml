<?xml version="1.0" encoding="utf-8"?>
<!-- The cover alone above the footer, with the mark on its corner: a narrow
     widget from 190dp tall (a 2x2), and any widget from 250dp. The 4x2 card's
     cover is as tall as the card and square, so past ~250dp it took the
     whole width and left no room for the title; the cover carries the title
     anyway. The cover scales to the space, so this fills any size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/saga_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/saga_widget_bg"
        android:tint="@color/saga_widget_surface" />

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/saga_widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <!-- Sized to the cover itself (wrap_content + adjustViewBounds keeps
             the square bitmap square, as large as fits), so the mark sits on
             the cover's corner rather than the space's. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/saga_widget_cover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/saga_widget_mark" />

            <!-- The app badge, as Audible and Spotify carry theirs. -->
            <ImageView
                android:id="@+id/saga_widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:adjustViewBounds="true"
                android:background="@drawable/saga_widget_badge_bg"
                android:importantForAccessibility="no"
                android:maxHeight="28dp"
                android:padding="6dp"
                android:src="@drawable/saga_widget_mark_mono"
                android:tint="@color/saga_widget_fg" />
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <ImageView
            android:id="@+id/saga_widget_footer_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/saga_widget_footer_bg"
            android:tint="@color/saga_widget_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- The player's skip glyph: an arrow with the seconds inside. -->
        <FrameLayout
            android:id="@+id/saga_widget_back_btn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/saga_widget_back_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/saga_widget_skip"
                android:tint="@color/saga_widget_accent_fg" />

            <TextView
                android:id="@+id/saga_widget_back_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:paddingTop="4dp"
                android:textColor="@color/saga_widget_accent_fg"
                android:textSize="9.5dp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Thirds: −30 | play | +30 share the footer, as on every size,
             rather than arrows pinned to the edges around a wide middle. -->
        <LinearLayout
            android:id="@+id/saga_widget_play_pause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/saga_widget_play_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/saga_widget_play" />

            <TextView
                android:id="@+id/saga_widget_play_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/saga_widget_accent_fg"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- The player's skip glyph: an arrow with the seconds inside. -->
        <FrameLayout
            android:id="@+id/saga_widget_forward_btn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/saga_widget_forward_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/saga_widget_skip_forward"
                android:tint="@color/saga_widget_accent_fg" />

            <TextView
                android:id="@+id/saga_widget_forward_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:paddingTop="4dp"
                android:textColor="@color/saga_widget_accent_fg"
                android:textSize="9.5dp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
    </FrameLayout>
</LinearLayout>
</FrameLayout>

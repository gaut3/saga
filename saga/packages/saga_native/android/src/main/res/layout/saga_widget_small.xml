<?xml version="1.0" encoding="utf-8"?>
<!-- Frame 09, small (170×170): 52dp cover with title and chapter beside it,
     time left · %, bar, footer −30 · play/pause · +30 (48dp targets). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/saga_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/saga_widget_bg"
        android:tint="@color/saga_widget_surface" />

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/saga_widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/saga_widget_cover"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/saga_widget_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <TextView
                    android:id="@+id/saga_widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/saga_widget_fg"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/saga_widget_chapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/saga_widget_fg_muted"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/saga_widget_time_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/saga_widget_fg"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/saga_widget_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/saga_widget_fg_subtle"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/saga_widget_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progressDrawable="@drawable/saga_widget_bar" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <ImageView
            android:id="@+id/saga_widget_footer_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/saga_widget_footer_bg"
            android:tint="@color/saga_widget_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/saga_widget_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/saga_widget_accent_fg"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/saga_widget_play_pause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/saga_widget_play_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/saga_widget_play" />
        </FrameLayout>

        <TextView
            android:id="@+id/saga_widget_forward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/saga_widget_accent_fg"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>
    </FrameLayout>
</LinearLayout>
</FrameLayout>

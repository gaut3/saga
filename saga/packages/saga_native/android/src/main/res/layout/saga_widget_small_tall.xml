<?xml version="1.0" encoding="utf-8"?>
<!-- The small card when it's tall (190dp and up, a 2x2 on most phones): the
     110dp card left ~60dp empty above the time left there, and its title
     wrapped in the narrow column beside the cover. Here the cover and badge
     have the top row, the title the full width beneath, and the bar stays at
     the bottom over the footer. No time left or %: the bar says how far.

     The card is 190dp tall, centred in whatever the launcher gives it,
     rather than filling it: a 2x2 is about as wide as that, so it reads as a
     square card (as Audible's does) instead of a tall one with a gap in it.
     190dp is what a two-line title needs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<FrameLayout
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="190dp"
    android:layout_gravity="center_vertical"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/saga_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/saga_widget_bg"
        android:tint="@color/saga_widget_surface" />

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/saga_widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/saga_widget_cover"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/saga_widget_mark" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- The app badge, as Audible and Spotify carry theirs. -->
            <ImageView
                android:id="@+id/saga_widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@drawable/saga_widget_mark_mono"
                android:tint="@color/saga_widget_fg" />
        </LinearLayout>

        <TextView
            android:id="@+id/saga_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/saga_widget_fg"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/saga_widget_chapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/saga_widget_fg_muted"
            android:textSize="12.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ProgressBar
            android:id="@+id/saga_widget_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="1000"
            android:progressDrawable="@drawable/saga_widget_bar" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <ImageView
            android:id="@+id/saga_widget_footer_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/saga_widget_footer_bg"
            android:tint="@color/saga_widget_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- The player's skip glyph: an arrow with the seconds inside. -->
        <FrameLayout
            android:id="@+id/saga_widget_back_btn"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/saga_widget_back_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/saga_widget_skip"
                android:tint="@color/saga_widget_accent_fg" />

            <TextView
                android:id="@+id/saga_widget_back_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:paddingTop="3.5dp"
                android:textColor="@color/saga_widget_accent_fg"
                android:textSize="9dp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/saga_widget_play_pause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/saga_widget_play_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/saga_widget_play" />
        </FrameLayout>

        <!-- The player's skip glyph: an arrow with the seconds inside. -->
        <FrameLayout
            android:id="@+id/saga_widget_forward_btn"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/saga_widget_forward_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/saga_widget_skip_forward"
                android:tint="@color/saga_widget_accent_fg" />

            <TextView
                android:id="@+id/saga_widget_forward_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:paddingTop="3.5dp"
                android:textColor="@color/saga_widget_accent_fg"
                android:textSize="9dp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
    </FrameLayout>
</LinearLayout>
</FrameLayout>
</FrameLayout>

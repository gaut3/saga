<?xml version="1.0" encoding="utf-8"?>
<!-- The empty and signed-out card at one row: mark, title and subtitle, the
     whole strip opening the app. No footer: at this height it left the text
     about 20dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/saga_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/saga_widget_bg"
        android:tint="@color/saga_widget_surface" />

    <LinearLayout
        android:id="@+id/saga_widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/saga_widget_empty_mark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/saga_widget_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/saga_widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/saga_widget_empty_title"
                android:textColor="@color/saga_widget_fg"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/saga_widget_empty_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/saga_widget_empty_subtitle"
                android:textColor="@color/saga_widget_fg_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

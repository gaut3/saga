<?xml version="1.0" encoding="utf-8"?>
<!-- Frame 09b: the same chassis with the mark in the cover slot and one
     action in the footer. Nothing in progress, or signed out. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/saga_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/saga_widget_bg"
        android:tint="@color/saga_widget_surface" />

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/saga_widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/saga_widget_empty_mark"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:src="@drawable/saga_widget_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/saga_widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/saga_widget_empty_title"
                android:textColor="@color/saga_widget_fg"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/saga_widget_empty_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="3"
                android:text="@string/saga_widget_empty_subtitle"
                android:textColor="@color/saga_widget_fg_muted"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <ImageView
            android:id="@+id/saga_widget_footer_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/saga_widget_footer_bg"
            android:tint="@color/saga_widget_accent" />

    <TextView
        android:id="@+id/saga_widget_empty_action"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/saga_widget_empty_action"
        android:textColor="@color/saga_widget_accent_fg"
        android:textSize="14.5sp"
        android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
</FrameLayout>

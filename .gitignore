# Claude Code local settings (permissions, hooks)
.claude/

# VS Code and workspace config
.vscode/
saga.code-workspace

# Internal development notes and codebase guide
# (numbered so they group together; CLAUDE.md keeps its name — Claude Code loads it by that exact name)
01-BACKLOG.md
02-SAGA_NOTES.md
03-SAGA_SECURITY_STANDARDS.md
CLAUDE.md

# Archived Gen-1 (3-spine) design material
Old design/

# Marketing canvas and working screenshots (internal design material)
Webpage/

# Release obfuscation output — keep locally for crash symbolication
build/debug-info/
*.apk

# Screen recordings used for reference/debugging — large, and not part of the
# project. The repo tracks no video assets.
# (anchored to root: on Windows git matches ignore patterns case-insensitively,
# so a bare "Screens/" would swallow new files in docs/screens/)
*.mp4
*.mov
/Screens/

# Bug-report material pulled off a device: the exported diagnostics log and
# working screenshots. Kept locally (diagnostics.md is the evidence for the
# uncaught-SocketException issue), never committed.
/diagnostics.md
/Screenshot_*.png
/assets
